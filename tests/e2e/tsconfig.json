{
	"compilerOptions": {
		"target": "ES2023",
		"module": "commonjs",
		"moduleResolution": "node10",
		"lib": [ "ES2023", "DOM", "DOM.Iterable" ],
		"types": [ "node" ],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [ "**/*.ts" ]
}
