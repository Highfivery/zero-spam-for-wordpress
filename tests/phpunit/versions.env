# Pinned versions for the PHPUnit suite.
#
# Read by bin/test.sh, bin/test-matrix.sh (sourced as shell) and by
# tests/phpunit/includes/env.php (parsed as KEY=VALUE). Keep it to plain
# KEY=VALUE lines.
#
# "latest" is the newest WordPress release, tested with the wp-phpunit version
# pinned in composer.json (it lags core by a patch release; same minor is fine).
# "min" is the oldest release matching "Requires at least" in readme.txt.
# Checksums: WordPress cores are verified against the published
# https://wordpress.org/wordpress-<version>.tar.gz.sha1 values pinned here; the
# wp-phpunit tag tarball for "min" is verified against a pinned sha256.

WP_LATEST=7.1.3
WP_LATEST_SHA1=491a78c7676b15dffcc69130c6054b8f49228a91
WP_LATEST_TESTLIB=7.1.1

WP_MIN=6.9.10
WP_MIN_SHA1=a68c82de3042bf095d6ecf9001aa06447b86232f
WP_MIN_TESTLIB=6.9.8
WP_MIN_TESTLIB_SHA256=a1ceee270434235c186fd178756cd3538806d3455cba1094d90714065766e577

PHP_MATRIX="8.2 8.4"
