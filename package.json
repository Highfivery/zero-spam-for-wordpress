{
	"private": true,
	"name": "zero-spam",
	"description": "Development tooling for Zero Spam for WordPress: the admin front-end build (@wordpress/scripts; sources in assets/src, committed output in assets/dist), its linters and unit tests, and the Playwright end-to-end, accessibility and visual-regression suite. Never shipped (see .distignore).",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js assets/src webpack.config.js eslint.config.cjs vitest.config.mjs",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.css\" \"assets/fonts/**/*.css\"",
		"test:js": "wp-scripts test-unit-js",
		"check:dist": "bin/check-dist.sh",
		"check:budget": "bin/check-dist.sh --budget-only",
		"e2e:install": "playwright install chromium",
		"e2e:setup:local": "node tests/e2e/bin/setup-local.mjs",
		"e2e:teardown:local": "node tests/e2e/bin/teardown-local.mjs",
		"env:start": "node tests/e2e/bin/check-node.mjs && wp-env start",
		"env:start:ms": "node tests/e2e/bin/check-node.mjs && wp-env start --config=.wp-env.multisite.json",
		"env:stop": "wp-env stop && wp-env stop --config=.wp-env.multisite.json",
		"env:destroy": "wp-env destroy && wp-env destroy --config=.wp-env.multisite.json",
		"env:core:min": "node tests/e2e/bin/run.mjs --switch-core=min",
		"env:core:latest": "node tests/e2e/bin/run.mjs --switch-core=latest",
		"test:e2e": "node tests/e2e/bin/run.mjs --target=local,network",
		"test:e2e:local": "node tests/e2e/bin/run.mjs --target=local",
		"test:e2e:network": "node tests/e2e/bin/run.mjs --target=network",
		"test:e2e:wp-env": "node tests/e2e/bin/run.mjs --target=wp-env,wp-env-ms --wp=latest",
		"test:e2e:wp-env:min": "node tests/e2e/bin/run.mjs --target=wp-env,wp-env-ms --wp=min",
		"test:e2e:matrix": "node tests/e2e/bin/run.mjs --target=wp-env,wp-env-ms --wp=latest,min",
		"test:a11y": "node tests/e2e/bin/run.mjs --target=wp-env,wp-env-ms --project=a11y",
		"test:visual": "node tests/e2e/bin/run.mjs --target=wp-env,wp-env-ms --wp=latest --project=visual",
		"test:visual:update": "node tests/e2e/bin/run.mjs --target=wp-env,wp-env-ms --wp=latest --project=visual --update-snapshots",
		"test:e2e:report": "node tests/e2e/bin/summarize.mjs artifacts/e2e/latest",
		"typecheck:e2e": "tsc --noEmit -p tests/e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.64.1",
		"@types/node": "22.20.5",
		"@wordpress/babel-preset-default": "9.0.0",
		"@wordpress/e2e-test-utils-playwright": "3.1.0",
		"@wordpress/env": "12.0.0",
		"@wordpress/eslint-plugin": "27.1.0",
		"@wordpress/prettier-config": "4.57.0",
		"@wordpress/scripts": "36.1.0",
		"@wordpress/stylelint-config": "26.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"webpack": "5.112.2"
	},
	"dependencies": {
		"@wordpress/i18n": "6.30.0"
	},
	"prettier": "@wordpress/prettier-config"
}
