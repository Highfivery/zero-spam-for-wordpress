parameters:
	ignoreErrors:
		-
			message: '#^Right side of \|\| is always false\.$#'
			identifier: booleanOr.rightAlwaysFalse
			count: 1
			path: core/class-access.php

		-
			message: '#^Call to static method add_command\(\) on an unknown class ZeroSpam\\Core\\WP_CLI\.$#'
			identifier: class.notFound
			count: 1
			path: core/class-cli.php

		-
			message: '#^Default value of the parameter \#1 \$key \(false\) of method ZeroSpam\\Core\\Settings\:\:get_settings\(\) is incompatible with type string\.$#'
			identifier: parameter.defaultValue
			count: 1
			path: core/class-settings.php

		-
			message: '#^Call to function is_wp_error\(\) with array\<mixed, mixed\> will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 2
			path: core/class-utilities.php

		-
			message: '#^Default value of the parameter \#1 \$setting_msg_key \(false\) of method ZeroSpam\\Core\\Utilities\:\:detection_message\(\) is incompatible with type string\.$#'
			identifier: parameter.defaultValue
			count: 1
			path: core/class-utilities.php

		-
			message: '#^Default value of the parameter \#1 \$setting_msg_key \(false\) of method ZeroSpam\\Core\\Utilities\:\:detection_title\(\) is incompatible with type string\.$#'
			identifier: parameter.defaultValue
			count: 1
			path: core/class-utilities.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: core/class-utilities.php

		-
			message: '#^Parameter \#1 \$months of static method ZeroSpam\\Includes\\Stats_Aggregator\:\:backfill_monthly\(\) expects int, float given\.$#'
			identifier: argument.type
			count: 1
			path: includes/class-cli.php

		-
			message: '#^Parameter \#2 \$site_id of method ZeroSpam\\Includes\\Network_Settings\:\:is_using_default\(\) expects int, string given\.$#'
			identifier: argument.type
			count: 2
			path: includes/class-networksettings.php

		-
			message: '#^Parameter \#1 \$new_blog_id of function switch_to_blog expects int, string given\.$#'
			identifier: argument.type
			count: 2
			path: includes/class-statsaggregator.php

		-
			message: '#^Parameter \#1 \$year of method ZeroSpam\\Includes\\Stats_Aggregator\:\:aggregate_month\(\) expects int, string given\.$#'
			identifier: argument.type
			count: 2
			path: includes/class-statsaggregator.php

		-
			message: '#^Parameter \#2 \$month of method ZeroSpam\\Includes\\Stats_Aggregator\:\:aggregate_month\(\) expects int, string given\.$#'
			identifier: argument.type
			count: 2
			path: includes/class-statsaggregator.php

		-
			message: '#^Action callback returns true but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: modules/class-zerospam.php

		-
			message: '#^Parameter \#4 \$response_time_ms of static method ZeroSpam\\Includes\\API_Usage_Tracker\:\:track_api_call\(\) expects int, float given\.$#'
			identifier: argument.type
			count: 1
			path: modules/class-zerospam.php

		-
			message: '#^Access to offset 0 on an unknown class ZeroSpam\\Modules\\ContactForm7\\WPCF7_FormTag\.$#'
			identifier: class.notFound
			count: 1
			path: modules/contactform7/class-contactform7.php

		-
			message: '#^Call to method invalidate\(\) on an unknown class ZeroSpam\\Modules\\ContactForm7\\WPCF7_Validation\.$#'
			identifier: class.notFound
			count: 1
			path: modules/contactform7/class-contactform7.php

		-
			message: '#^Parameter \$result of method ZeroSpam\\Modules\\ContactForm7\\ContactForm7\:\:process_form\(\) has invalid type ZeroSpam\\Modules\\ContactForm7\\WPCF7_Validation\.$#'
			identifier: class.notFound
			count: 1
			path: modules/contactform7/class-contactform7.php

		-
			message: '#^Parameter \$tag of method ZeroSpam\\Modules\\ContactForm7\\ContactForm7\:\:process_form\(\) has invalid type ZeroSpam\\Modules\\ContactForm7\\WPCF7_FormTag\.$#'
			identifier: class.notFound
			count: 1
			path: modules/contactform7/class-contactform7.php

		-
			message: '#^Function give_clean not found\.$#'
			identifier: function.notFound
			count: 1
			path: modules/give/class-give.php

		-
			message: '#^Function give_set_error not found\.$#'
			identifier: function.notFound
			count: 1
			path: modules/give/class-give.php

		-
			message: '#^Callback expects 1 parameter, \$accepted_args is set to 2\.$#'
			identifier: arguments.count
			count: 1
			path: modules/gravityforms/class-gravityforms.php

		-
			message: '#^Function rgar not found\.$#'
			identifier: function.notFound
			count: 1
			path: modules/gravityforms/class-gravityforms.php

		-
			message: '#^Parameter \$form of method ZeroSpam\\Modules\\GravityForms\\GravityForms\:\:process_form\(\) has invalid type ZeroSpam\\Modules\\GravityForms\\FormObject\.$#'
			identifier: class.notFound
			count: 1
			path: modules/gravityforms/class-gravityforms.php

		-
			message: '#^Constant COOKIEPATH not found\.$#'
			identifier: constant.notFound
			count: 1
			path: modules/login/class-login.php

		-
			message: '#^Parameter \$element of method ZeroSpam\\Modules\\MailchimpForWP\\MailchimpForWP\:\:add_honeypot\(\) has invalid type ZeroSpam\\Modules\\MailchimpForWP\\MC4WP_Form_Element\.$#'
			identifier: class.notFound
			count: 1
			path: modules/mailchimpforwp/class-mailchimpforwp.php

		-
			message: '#^Parameter \$form of method ZeroSpam\\Modules\\MailchimpForWP\\MailchimpForWP\:\:add_honeypot\(\) has invalid type ZeroSpam\\Modules\\MailchimpForWP\\MC4WP_Form\.$#'
			identifier: class.notFound
			count: 1
			path: modules/mailchimpforwp/class-mailchimpforwp.php

		-
			message: '#^Call to method add\(\) on an unknown class ZeroSpam\\Modules\\Registration\\WP_Error\.$#'
			identifier: class.notFound
			count: 1
			path: modules/registration/class-registration.php

		-
			message: '#^Parameter \$errors of method ZeroSpam\\Modules\\Registration\\Registration\:\:process_form\(\) has invalid type ZeroSpam\\Modules\\Registration\\WP_Error\.$#'
			identifier: class.notFound
			count: 1
			path: modules/registration/class-registration.php

		-
			message: '#^Callback expects 1 parameter, \$accepted_args is set to 2\.$#'
			identifier: arguments.count
			count: 3
			path: modules/security/class-security.php

		-
			message: '#^Callback expects 1 parameter, \$accepted_args is set to 2\.$#'
			identifier: arguments.count
			count: 1
			path: modules/woocommerce/class-woocommerce.php

		-
			message: '#^Cannot call method add\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: modules/woocommerce/class-woocommerce.php

		-
			message: '#^Function wc_add_notice not found\.$#'
			identifier: function.notFound
			count: 1
			path: modules/woocommerce/class-woocommerce.php

		-
			message: '#^Function woocommerce_form_field not found\.$#'
			identifier: function.notFound
			count: 1
			path: modules/woocommerce/class-woocommerce.php

		-
			message: '#^Function wpforms not found\.$#'
			identifier: function.notFound
			count: 1
			path: modules/wpforms/class-wpforms.php

		-
			message: '#^Right side of && is always false\.$#'
			identifier: booleanAnd.rightAlwaysFalse
			count: 1
			path: wordpress-zero-spam.php
